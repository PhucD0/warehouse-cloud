#pragma once

// Copy this file to arduino_secrets.h and fill in your local values.
// Keep MQTT_BROKER in the same format as the cloud .env value.

#define WIFI_SSID "<wifi-ssid>"
#define WIFI_PASSWORD "<wifi-password>"

#define MQTT_BROKER "mqtts://<hivemq-host>:8883"
#define MQTT_PORT 8883
#define MQTT_USERNAME "<hivemq-username>"
#define MQTT_PASSWORD "<hivemq-password>"

// Set to 1 for the easiest Arduino IDE setup with HiveMQ Cloud TLS.
// Set to 0 only if you add a valid CA certificate and call setCACert below.
#define MQTT_USE_INSECURE_TLS 1
