# Required for persistent database on MongoDB Atlas
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/warehouse?retryWrites=true&w=majority

# Hosting providers usually inject PORT automatically.
# For local development, you may keep this commented or set PORT=3000.
# PORT=3000

# Match Jetson schema from the handoff document
DEFAULT_SHELF_ID=SHELF_A

# Set true only if you want fake demo data on an empty database
SEED_DEMO_DATA=false

# Optional. Keep * for demo. For production, set your dashboard domain.
CORS_ORIGIN=*

# Optional HiveMQ bridge for ESP32 shelf LEDs.
# Keep these values in your local .env or hosting provider secrets, not in git.
MQTT_BROKER_URL=mqtts://<hivemq-host>:8883
MQTT_USERNAME=<hivemq_username>
MQTT_PASSWORD=<hivemq_password>
MQTT_TOPIC_PREFIX=warehouse
MQTT_LED_RETAIN=true
MQTT_LED_QOS=1
MQTT_LED_BLINK_MS=500
MQTT_LED_TIMEOUT_MS=120000
